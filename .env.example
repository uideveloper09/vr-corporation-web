# Public site URL used for canonical, Open Graph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# Where enquiries are delivered
ENQUIRY_TO_EMAIL=jitender@logicalfire.com

# Preferred (Bitcraftly pattern): Resend API key — from address must be a verified domain
# RESEND_API_KEY=
# ENQUIRY_FROM_EMAIL=V R Corporation Website <noreply@bitcraftly.com>

# No SMTP needed — FormSubmit.co is used as automatic fallback (same as Bitcraftly site).
# First submit to a new inbox: open the FormSubmit confirmation email once.

# Optional SMTP backup
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Optional: also append to Google Sheet
# GOOGLE_SHEETS_WEBHOOK_URL=
